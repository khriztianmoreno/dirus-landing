# Editor defaults shared across the team.
# Prettier owns formatting for the file types it supports; this file covers
# everything else — and every editor, before Prettier ever runs.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so stripping them
# silently changes how a document renders.
[*.md]
trim_trailing_whitespace = false

# Generated by pnpm; never edited by hand.
[pnpm-lock.yaml]
insert_final_newline = false
trim_trailing_whitespace = false
